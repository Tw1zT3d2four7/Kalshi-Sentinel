# Discord application
CLIENT_TOKEN=replace_with_discord_bot_token
APPLICATION_ID=replace_with_discord_application_id

# Required: 32-byte key encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_character_hex_key

# Kalshi API environment. Keep demo as the default until live trading is
# deliberately enabled and tested.
KALSHI_BASE_URL=https://demo-api.kalshi.co
